{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Streamgraph of wildlife observation composition in 2017–2026, showing the top ten species selected within the selected observation years, with 4,139 records in the displayed ten available years. Source: Dataset/observations-794195.csv. Species selected by observation count in the selected years; subspecies combined by the first two scientific-name components. Includes records without coordinates. Zero-count species-years retained. Annual counts use observation dates. A centered stack gives a streamgraph: band thickness represents observation count; vertical band position has no numeric meaning. Monotone interpolation smoothly connects the recorded annual values; curves between years are visual interpolation, not additional observations. Tooltip shares use the total of the displayed ten species in the given year. Hover or click bands or legend to highlight; click again, Clear highlight, or Escape clears selection. Counts reflect recording activity, not animal abundance. Drag outside the highlighted overview range to select years; drag the highlight to move the range, or drag either edge to resize it. Use Reset to restore 2017–2026. Legend totals cover the full period. Species colours match the ten-species palette in BumpChart.vg.json; species selection uses the selected years; annual counts and legend totals cover 2017–2026. Three in-chart annotations highlight the 2022 Koala increase, the 2024 annual-total peak, and the 2025 decline; anchors use the current centered stack and annotations hide when their year is outside the focus range. Uses the 10 most recent available observation years (2017–2026), including partial 2026.",
  "width": 800,
  "height": 400,
  "padding": 16,
  "background": "#f7fafc",
  "title": {
    "text": "How does wildlife observation composition change over the years?",
    "subtitle": [
      "Changing species composition · 2017–2026"
    ],
    "anchor": "start",
    "font": "Arial",
    "fontSize": 22,
    "color": "#243447",
    "subtitleFont": "Arial",
    "subtitleFontSize": 12,
    "subtitleColor": "#52606d",
    "offset": 16,
    "subtitlePadding": 6,
    "subtitleLineHeight": 16,
    "fontWeight": "bold"
  },
  "signals": [
    {
      "name": "pointerScale",
      "value": 1
    },
    {
      "name": "pointerOffset",
      "value": 0
    },
    {
      "name": "minYear",
      "value": 2017
    },
    {
      "name": "maxYear",
      "value": 2026
    },
    {
      "name": "brushDragStart",
      "value": {
        "year": 2017,
        "range": [
          2017,
          2026
        ]
      },
      "on": [
        {
          "events": "@brushSelection:mousedown, @brushHandle0:mousedown, @brushHandle1:mousedown",
          "update": "{year: invert('overviewX', ((x() + pointerOffset) / pointerScale - pointerOffset)), range: slice(yearRange), mode: (yearRange[0] === minYear && yearRange[1] === maxYear) || event.shiftKey ? 'new' : 'move'}"
        }
      ]
    },
    {
      "name": "yearRange",
      "value": [
        2017,
        2026
      ],
      "on": [
        {
          "events": "@brushTarget:mousedown",
          "update": "[round(clamp(invert('overviewX', ((x() + pointerOffset) / pointerScale - pointerOffset)), minYear, maxYear)), round(clamp(invert('overviewX', ((x() + pointerOffset) / pointerScale - pointerOffset)), minYear, maxYear))]"
        },
        {
          "events": "@brushSelection:mousedown",
          "update": "(yearRange[0] === minYear && yearRange[1] === maxYear) || event.shiftKey ? [round(clamp(invert('overviewX', ((x() + pointerOffset) / pointerScale - pointerOffset)), minYear, maxYear)), round(clamp(invert('overviewX', ((x() + pointerOffset) / pointerScale - pointerOffset)), minYear, maxYear))] : yearRange"
        },
        {
          "events": "[@brushTarget:mousedown, window:mouseup] > window:mousemove!",
          "update": "[min(brushAnchor, round(clamp(invert('overviewX', ((x() + pointerOffset) / pointerScale - pointerOffset)), minYear, maxYear))), max(brushAnchor, round(clamp(invert('overviewX', ((x() + pointerOffset) / pointerScale - pointerOffset)), minYear, maxYear)))]"
        },
        {
          "events": "[@brushSelection:mousedown, window:mouseup] > window:mousemove!",
          "update": "brushDragStart.mode === 'new' ? [min(round(brushDragStart.year), round(clamp(invert('overviewX', ((x() + pointerOffset) / pointerScale - pointerOffset)), minYear, maxYear))), max(round(brushDragStart.year), round(clamp(invert('overviewX', ((x() + pointerOffset) / pointerScale - pointerOffset)), minYear, maxYear)))] : [brushDragStart.range[0] + clamp(round(invert('overviewX', ((x() + pointerOffset) / pointerScale - pointerOffset)) - brushDragStart.year), minYear - brushDragStart.range[0], maxYear - brushDragStart.range[1]), brushDragStart.range[1] + clamp(round(invert('overviewX', ((x() + pointerOffset) / pointerScale - pointerOffset)) - brushDragStart.year), minYear - brushDragStart.range[0], maxYear - brushDragStart.range[1])]"
        },
        {
          "events": "[@brushHandle0:mousedown, window:mouseup] > window:mousemove!",
          "update": "[round(clamp(invert('overviewX', ((x() + pointerOffset) / pointerScale - pointerOffset)), minYear, brushDragStart.range[1])), brushDragStart.range[1]]"
        },
        {
          "events": "[@brushHandle1:mousedown, window:mouseup] > window:mousemove!",
          "update": "[brushDragStart.range[0], round(clamp(invert('overviewX', ((x() + pointerOffset) / pointerScale - pointerOffset)), brushDragStart.range[0], maxYear))]"
        },
        {
          "events": "@resetYears:click",
          "update": "[minYear, maxYear]"
        }
      ]
    },
    {
      "name": "brushAnchor",
      "value": 2017,
      "on": [
        {
          "events": "@brushTarget:mousedown",
          "update": "round(clamp(invert('overviewX', ((x() + pointerOffset) / pointerScale - pointerOffset)), minYear, maxYear))"
        }
      ]
    },
    {
      "name": "hoveredSpecies",
      "value": null,
      "on": [
        {
          "events": "@speciesAreas:mouseover, @yearPoints:mouseover, @legendSymbols:mouseover, @legendLabels:mouseover",
          "update": "datum.species"
        },
        {
          "events": "@speciesAreas:mouseout, @yearPoints:mouseout, @legendSymbols:mouseout, @legendLabels:mouseout",
          "update": "null"
        }
      ]
    },
    {
      "name": "selectedSpecies",
      "value": null,
      "on": [
        {
          "events": "@speciesAreas:click, @yearPoints:click, @legendSymbols:click, @legendLabels:click",
          "update": "selectedSpecies == datum.species ? null : datum.species"
        },
        {
          "events": "window:keydown[event.key === 'Escape']",
          "update": "null"
        }
      ]
    },
    {
      "name": "activeSpecies",
      "update": "hoveredSpecies != null ? hoveredSpecies : selectedSpecies"
    },
    {
      "name": "legendColumnWidth",
      "value": 280
    },
    {
      "name": "legendSymbolSize",
      "value": 100
    }
  ],
