    {
      "name": "focusedCounts",
      "source": "annualCounts",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.year >= yearRange[0] && datum.year <= yearRange[1]"
        },
        {
          "type": "joinaggregate",
          "groupby": [
            "year"
          ],
          "fields": [
            "count"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "yearTotal"
          ]
        },
        {
          "type": "stack",
          "groupby": [
            "year"
          ],
          "field": "count",
          "sort": {
            "field": "order",
            "order": "ascending"
          },
          "as": [
            "y0",
            "y1"
          ],
          "offset": "center"
        }
      ]
    },
    {
      "name": "yearTotals",
      "source": "annualCounts",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "year"
          ],
          "fields": [
            "count"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "total"
          ]
        }
      ]
    },
    {
      "name": "insightAnnotations",
      "source": "focusedCounts",
      "transform": [
        {
          "type": "filter",
          "expr": "(datum.year == 2022 && datum.species == 'Koala') || ((datum.year == 2024 || datum.year == 2025) && datum.order == 9)"
        },
        {
          "type": "formula",
          "expr": "datum.year == 2022 ? 0 : datum.year == 2024 ? width / 3 + 8 : 2 * width / 3 + 16",
          "as": "labelX"
        },
        {
          "type": "formula",
          "expr": "datum.year == 2022 ? '2022 · Koala records surge' : datum.year == 2024 ? '2024 · Most observations' : '2025 · Recording slows'",
          "as": "heading"
        },
        {
          "type": "formula",
          "expr": "datum.year == 2022 ? 'Koala recording activity rises.' : datum.year == 2024 ? 'Recording activity reaches a peak.' : 'Recording activity eases.'",
          "as": "detail"
        },
        {
          "type": "formula",
          "expr": "datum.year == 2022 ? 'A shift in species composition.' : datum.year == 2024 ? 'Koalas remain prominent.' : 'Species contributions continue to change.'",
          "as": "detail2"
        },
        {
          "type": "formula",
          "expr": "datum.year == 2022 ? (datum.y0 + datum.y1) / 2 : datum.y1",
          "as": "anchorY"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {
        "signal": "yearRange[0] === yearRange[1] ? [yearRange[0] - 0.5, yearRange[1] + 0.5] : yearRange"
      },
      "range": "width",
      "zero": false,
      "nice": false
    },
    {
      "name": "y",
      "type": "linear",
      "domain": {
        "data": "focusedCounts",
        "fields": [
          "y0",
          "y1"
        ]
      },
      "range": [
        {
          "signal": "height"
        },
        90
      ],
      "zero": true,
      "nice": false
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "Koala",
        "Platypus",
        "Grey-headed Flying-fox",
        "Greater Glider",
        "Spotted-tailed Quoll",
        "European Rabbit",
