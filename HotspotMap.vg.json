{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Wildlife observations are not evenly distributed. Some places attract far more records than others. Hotspots may reflect both wildlife presence and where people are more likely to observe and report animals.",
  "background": "#f7fafc",
  "padding": 5,
  "width": 800,
  "height": 650,
  "title": {
    "text": "Wildlife Observations — Binned Map",
    "subtitle": [
      "Sightings counted within square geographic bins",
      "Colour shows an observation-count range. Hover for exact counts."
    ],
    "anchor": "start",
    "offset": 20
  },
  "style": "view",
  "data": [
    {
      "name": "source_0",
      "url": "data/australia_states.geojson",
      "format": {
        "type": "json",
        "property": "features"
      }
    },
    {
      "name": "source_1",
      "url": "data/observations-794195.csv",
      "format": {
        "type": "csv",
        "parse": {
          "latitude": "number",
          "longitude": "number"
        }
      },
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.latitude) && isValid(datum.longitude) && datum.latitude >= -90 && datum.latitude <= 90 && datum.longitude >= -180 && datum.longitude <= 180"
        },
        {
          "type": "formula",
          "expr": "floor(datum.longitude / gridSize) * gridSize",
          "as": "longitude_min"
        },
        {
          "type": "formula",
          "expr": "floor(datum.latitude / gridSize) * gridSize",
          "as": "latitude_min"
        },
        {
          "type": "aggregate",
          "groupby": [
            "longitude_min",
            "latitude_min"
          ],
          "ops": [
            "count"
          ],
          "fields": [
            null
          ],
          "as": [
            "observation_count"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.longitude_min + gridSize",
          "as": "longitude_max"
        },
        {
          "type": "formula",
          "expr": "datum.latitude_min + gridSize",
          "as": "latitude_max"
        },
        {
          "type": "formula",
          "expr": "format(datum.longitude_min, '.2f') + ', ' + format(datum.latitude_min, '.2f') + ' (' + gridSize + '°)'",
          "as": "grid_cell"
        },
        {
          "type": "formula",
          "expr": "{'type': 'Feature', 'geometry': {'type': 'Polygon', 'coordinates': [[[datum.longitude_min, datum.latitude_min], [datum.longitude_min, datum.latitude_max], [datum.longitude_max, datum.latitude_max], [datum.longitude_max, datum.latitude_min], [datum.longitude_min, datum.latitude_min]]]}, 'properties': {}}",
          "as": "cell_geometry"
        },
        {
          "type": "formula",
          "expr": "datum.observation_count < 5 ? '1–4' : datum.observation_count < 20 ? '5–19' : datum.observation_count < 50 ? '20–49' : datum.observation_count < 200 ? '50–199' : datum.observation_count < 500 ? '200–499' : '500+'",
          "as": "count_bin"
        }
      ]
    }
  ],
  "projections": [
    {
      "name": "projection",
      "translate": {
        "signal": "[width / 2, height / 2]"
      },
      "type": "mercator",
      "center": [
        136,
        -36
      ],
      "scale": 570
    }
  ],
  "signals": [
    {
      "name": "gridSize",
      "value": 0.5,
      "bind": {
        "input": "select",
        "name": "Spatial bin size: ",
        "options": [
          0.25,
          0.5,
          1,
          2
        ],
        "labels": [
          "0.25° × 0.25°",
          "0.5° × 0.5°",
          "1° × 1°",
          "2° × 2°"
        ]
      }
    }
  ],
  "marks": [
    {
      "name": "layer_0_marks",
      "type": "shape",
      "clip": true,
      "style": [
        "geoshape"
      ],
      "from": {
        "data": "source_0"
      },
      "encode": {
        "update": {
          "fill": {
            "value": "#e8ede5"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 1
          },
          "ariaRoleDescription": {
            "value": "geoshape"
          }
        }
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "projection"
        }
      ]
    },
    {
      "name": "layer_1_marks",
      "type": "shape",
      "clip": true,
      "style": [
        "geoshape"
      ],
      "from": {
        "data": "source_1"
      },
      "encode": {
        "update": {
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 0.5
          },
          "fill": {
            "scale": "color",
            "field": "count_bin"
          },
          "tooltip": {
            "signal": "{\"Spatial bin (west, south)\": isValid(datum[\"grid_cell\"]) ? datum[\"grid_cell\"] : \"\"+datum[\"grid_cell\"], \"Observations\": format(datum[\"observation_count\"], \",d\"), \"Count range\": isValid(datum[\"count_bin\"]) ? datum[\"count_bin\"] : \"\"+datum[\"count_bin\"], \"West longitude\": format(datum[\"longitude_min\"], \".2f\"), \"East longitude\": format(datum[\"longitude_max\"], \".2f\"), \"South latitude\": format(datum[\"latitude_min\"], \".2f\"), \"North latitude\": format(datum[\"latitude_max\"], \".2f\")}"
          },
          "ariaRoleDescription": {
            "value": "geoshape"
          },
          "description": {
            "signal": "\"Observations per bin: \" + (isValid(datum[\"count_bin\"]) ? datum[\"count_bin\"] : \"\"+datum[\"count_bin\"]) + \"; cell_geometry: \" + (isValid(datum[\"cell_geometry\"]) ? datum[\"cell_geometry\"] : \"\"+datum[\"cell_geometry\"]) + \"; Spatial bin (west, south): \" + (isValid(datum[\"grid_cell\"]) ? datum[\"grid_cell\"] : \"\"+datum[\"grid_cell\"]) + \"; Observations: \" + (format(datum[\"observation_count\"], \",d\")) + \"; Count range: \" + (isValid(datum[\"count_bin\"]) ? datum[\"count_bin\"] : \"\"+datum[\"count_bin\"]) + \"; West longitude: \" + (format(datum[\"longitude_min\"], \".2f\")) + \"; East longitude: \" + (format(datum[\"longitude_max\"], \".2f\")) + \"; South latitude: \" + (format(datum[\"latitude_min\"], \".2f\")) + \"; North latitude: \" + (format(datum[\"latitude_max\"], \".2f\"))"
          }
        }
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "projection",
          "field": "datum[\"cell_geometry\"]"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "1–4",
        "5–19",
        "20–49",
        "50–199",
        "200–499",
        "500+"
      ],
      "range": [
        "#fff0c2",
        "#fdd49e",
        "#fdbb84",
        "#fc8d59",
        "#e34a33",
        "#b30000"
      ],
      "interpolate": "hcl"
    }
  ],
  "legends": [
    {
      "columns": 6,
      "direction": "horizontal",
      "labelLimit": 100,
      "orient": "bottom",
      "symbolSize": 180,
      "symbolType": "square",
      "title": "Observations per bin",
      "fill": "color",
      "encode": {
        "symbols": {
          "update": {
            "stroke": {
              "value": "#ffffff"
            }
          }
        }
      }
    }
  ],
  "config": {
    "style": {
      "guide-label": {
        "font": "Arial"
      },
      "guide-title": {
        "font": "Arial"
      },
      "group-title": {
        "font": "Arial",
        "fontSize": 24,
        "fill": "#203a32"
      },
      "group-subtitle": {
        "font": "Arial"
      },
      "cell": {
        "stroke": null
      },
      "text": {
        "font": "Arial"
      }
    },
    "title": {
      "subtitleColor": "#52606d",
      "subtitleFontSize": 13
    }
  }
}
