{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "100% stacked seasonal bars showing geographic distribution of Orange-bellied Parrot occurrence records by state. Source: Dataset/orange_bellied_parrot_cleaned.csv (5,942 PRESENT records in the full source; 2,154 in 2017–2026). Use month when present; recover missing months from complete eventDate (0 records recovered; no conflicting months). Exclude 1,948 records without a usable month and 0 additional month-known records without stateProvince. The remaining 206 records have reported years spanning 2017–2026. No coordinate filter or deduplication is applied. Each bar is normalized by its own seasonal total, using stateProvince as supplied. Australian seasons: Summer Dec–Feb, Autumn Mar–May, Winter Jun–Aug, Spring Sep–Nov. Seasonal shares describe occurrence recording, not abundance or tracked migration. Highlighting does not change counts or denominators. Pointing annotations above the seasonal bars relate the observed summer-to-winter shift to the documented Orange-bellied Parrot migration cycle; occurrence records alone do not track individual birds. Ecological context: NRE Tasmania, About Orange-bellied Parrots. Uses the 10 most recent available observation years (2017–2026), using year with eventDate fallback, including partial 2026. Year filtering occurs before month/state inclusion and seasonal aggregation.",
  "width": 850,
  "height": 500,
  "padding": 16,
  "background": "#f7fafc",
  "title": {
    "text": "How does the parrot’s geographic distribution change by season?",
    "subtitle": [
      "Orange-bellied Parrot · Seasonal distribution · 2017–2026"
    ],
    "anchor": "start",
    "font": "Arial",
    "fontSize": 22,
    "color": "#243447",
    "subtitleFontSize": 12,
    "subtitleColor": "#52606d",
    "offset": 16,
    "subtitlePadding": 6,
    "subtitleLineHeight": 16,
    "fontWeight": "bold",
    "subtitleFont": "Arial"
  },
  "signals": [
    {
      "name": "hoveredRegion",
      "value": null,
      "on": [
        {
          "events": "@bars:mouseover, @legendSymbols:mouseover, @legendLabels:mouseover",
          "update": "datum.region"
        },
        {
          "events": "@bars:mouseout, @legendSymbols:mouseout, @legendLabels:mouseout",
          "update": "null"
        }
      ]
    },
    {
      "name": "selectedRegion",
      "value": null,
      "on": [
        {
          "events": "@bars:click, @legendSymbols:click, @legendLabels:click",
          "update": "selectedRegion === datum.region ? null : datum.region"
        },
        {
          "events": "window:keydown[event.key === 'Escape']",
          "update": "null"
        }
      ]
    },
    {
      "name": "activeRegion",
      "update": "hoveredRegion != null ? hoveredRegion : selectedRegion"
    },
    {
      "name": "legendOffset",
      "value": -120
    },
    {
      "name": "legendColumnWidth",
      "value": 280
    },
    {
      "name": "legendSymbolSize",
      "value": 100
    }
  ],
  "data": [
    {
      "name": "regionCounts",
      "values": [
        {
          "season": "Summer",
          "seasonOrder": 0,
          "region": "Tasmania",
          "regionOrder": 0,
          "count": 53
        },
        {
          "season": "Summer",
          "seasonOrder": 0,
          "region": "Victoria",
          "regionOrder": 1,
          "count": 4
        },
        {
          "season": "Summer",
          "seasonOrder": 0,
          "region": "South Australia",
          "regionOrder": 2,
          "count": 0
        },
        {
          "season": "Summer",
          "seasonOrder": 0,
          "region": "New South Wales",
          "regionOrder": 3,
          "count": 0
        },
        {
          "season": "Autumn",
          "seasonOrder": 1,
          "region": "Tasmania",
          "regionOrder": 0,
          "count": 14
        },
        {
          "season": "Autumn",
          "seasonOrder": 1,
          "region": "Victoria",
          "regionOrder": 1,
          "count": 45
        },
        {
          "season": "Autumn",
          "seasonOrder": 1,
          "region": "South Australia",
          "regionOrder": 2,
          "count": 4
        },
        {
          "season": "Autumn",
          "seasonOrder": 1,
          "region": "New South Wales",
          "regionOrder": 3,
          "count": 0
        },
        {
          "season": "Winter",
          "seasonOrder": 2,
          "region": "Tasmania",
          "regionOrder": 0,
          "count": 0
        },
        {
          "season": "Winter",
          "seasonOrder": 2,
          "region": "Victoria",
          "regionOrder": 1,
          "count": 19
        },
        {
          "season": "Winter",
          "seasonOrder": 2,
          "region": "South Australia",
          "regionOrder": 2,
          "count": 5
        },
        {
          "season": "Winter",
          "seasonOrder": 2,
          "region": "New South Wales",
          "regionOrder": 3,
          "count": 0
        },
        {
          "season": "Spring",
          "seasonOrder": 3,
          "region": "Tasmania",
          "regionOrder": 0,
          "count": 45
        },
        {
          "season": "Spring",
          "seasonOrder": 3,
          "region": "Victoria",
          "regionOrder": 1,
          "count": 15
        },
        {
          "season": "Spring",
          "seasonOrder": 3,
          "region": "South Australia",
          "regionOrder": 2,
          "count": 1
        },
        {
          "season": "Spring",
          "seasonOrder": 3,
          "region": "New South Wales",
          "regionOrder": 3,
          "count": 1
        }
      ],
      "transform": [
        {
          "type": "joinaggregate",
          "groupby": [
            "season"
          ],
          "fields": [
            "count"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "total"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.count / datum.total",
          "as": "share"
        },
        {
          "type": "stack",
          "groupby": [
            "season"
          ],
          "field": "count",
          "sort": {
            "field": "regionOrder",
            "order": "ascending"
          },
          "offset": "normalize",
          "as": [
            "x0",
            "x1"
          ]
        }
      ]
    },
    {
      "name": "seasonTotals",
      "source": "regionCounts",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "season",
            "seasonOrder"
          ],
          "fields": [
            "count"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "total"
          ]
        }
      ]
    },
    {
      "name": "regions",
      "values": [
        {
          "region": "Tasmania",
          "order": 0
        },
        {
          "region": "Victoria",
          "order": 1
        },
        {
          "region": "South Australia",
          "order": 2
        },
        {
          "region": "New South Wales",
          "order": 3
        }
      ]
    },
    {
      "name": "seasonInsights",
      "values": [
        {
          "season": "Summer",
          "heading": "Summer: breeding season",
          "lines": [
            "Tasmania leads records, consistent",
            "with breeding in the island’s south-west."
          ],
          "position": 0.4649122807017544
        },
        {
          "season": "Autumn",
          "heading": "Autumn: migration",
          "lines": [
            "Records span Tasmania and the mainland,",
            "consistent with crossing Bass Strait."
          ],
          "position": 0.5793650793650793
        },
        {
          "season": "Winter",
          "heading": "Winter: coastal feeding",
          "lines": [
            "Victoria and South Australia lead records",
            "from coastal saltmarsh feeding grounds."
          ],
          "position": 0.65
        }
      ]
    },
    {
      "name": "annotationTargets",
      "source": "regionCounts",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.count > 0 && ((datum.season === 'Summer' && datum.region === 'Tasmania') || (datum.season === 'Autumn' && datum.region === 'Victoria') || (datum.season === 'Winter' && (datum.region === 'Victoria' || datum.region === 'South Australia')))"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": [
        0,
        1
      ],
      "range": "width",
      "zero": true,
      "nice": false
    },
    {
      "name": "y",
      "type": "band",
      "domain": {
        "data": "seasonTotals",
        "field": "season",
        "sort": {
          "op": "min",
          "field": "seasonOrder",
          "order": "ascending"
        }
      },
      "range": [
        64,
        {
          "signal": "height"
        }
      ],
      "paddingInner": 0.5,
      "paddingOuter": 0.06
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "Tasmania",
        "Victoria",
        "South Australia",
        "New South Wales"
      ],
      "range": [
        "#7A3E65",
        "#56733C",
        "#E3B34F",
        "#A65B35"
      ]
    }
  ],
  "axes": [
    {
      "orient": "bottom",
      "scale": "x",
      "title": "Share of each season’s occurrence records",
      "format": ".0%",
      "values": [
        0,
        0.25,
        0.5,
        0.75,
        1
      ],
      "grid": true,
      "gridColor": "#e3e9ef",
      "domain": false,
      "tickColor": "#c9d4df",
      "labelColor": "#52606d",
      "titleColor": "#243447",
      "titlePadding": 14
    },
    {
      "orient": "left",
      "scale": "y",
      "domain": false,
      "ticks": false,
      "labelPadding": 12,
      "labelLimit": 230,
      "labelFontSize": 12,
      "labelColor": "#243447",
      "encode": {
        "labels": {
          "update": {
            "text": {
              "signal": "datum.value + ' (' + ['Dec–Feb', 'Mar–May', 'Jun–Aug', 'Sep–Nov'][indexof(domain('y'), datum.value)] + ')'"
            }
          }
        }
      }
    }
  ],
  "marks": [
    {
      "name": "bars",
      "type": "rect",
      "from": {
        "data": "regionCounts"
      },
      "encode": {
        "enter": {
          "cursor": {
            "value": "pointer"
          }
        },
        "update": {
          "x": {
            "scale": "x",
            "field": "x0"
          },
          "x2": {
            "scale": "x",
            "field": "x1"
          },
          "y": {
            "scale": "y",
            "field": "season"
          },
          "height": {
            "signal": "bandwidth('y')"
          },
          "fill": {
            "scale": "color",
            "field": "region"
          },
          "fillOpacity": {
            "signal": "activeRegion == null || activeRegion === datum.region ? 1 : 0.2"
          },
          "stroke": {
            "value": "#f7fafc"
          },
          "strokeWidth": {
            "value": 1
          },
          "tooltip": {
            "signal": "{'Species': 'Orange-bellied Parrot', 'Season': datum.season, 'State': datum.region, 'Share of seasonal records': format(datum.share, '.1%'), 'State records this season': format(datum.count, ',d'), 'Season total': format(datum.total, ',d'), 'Period': '2017–2026'}"
          },
          "description": {
            "signal": "datum.season + ', ' + datum.region + ': ' + format(datum.share, '.1%') + ', ' + datum.count + ' records'"
          }
        }
      }
    },
    {
      "type": "text",
      "interactive": false,
      "from": {
        "data": "regionCounts"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "scale('x', (datum.x0 + datum.x1) / 2)"
          },
          "y": {
            "scale": "y",
            "field": "season",
            "band": 0.5
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "signal": "datum.share >= 0.05 ? format(datum.share, '.1%') : ''"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "signal": "datum.region === 'South Australia' ? '#243447' : '#ffffff'"
          },
          "opacity": {
            "signal": "activeRegion == null || activeRegion === datum.region ? 1 : 0.2"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "seasonTotals"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "width + 12"
          },
          "y": {
            "scale": "y",
            "field": "season",
            "band": 0.5
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#52606d"
          },
          "text": {
            "value": ""
          }
        }
      }
    },
    {
      "type": "symbol",
      "name": "legendSymbols",
      "from": {
        "data": "regions"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "legendOffset + 8 + (datum.order % 3) * legendColumnWidth"
          },
          "y": {
            "signal": "-50 + floor(datum.order / 3) * 24"
          },
          "cursor": {
            "value": "pointer"
          },
          "opacity": {
            "signal": "activeRegion == null || activeRegion === datum.region ? 1 : 0.3"
          },
          "shape": {
            "value": "square"
          },
          "size": {
            "signal": "legendSymbolSize"
          },
          "fill": {
            "scale": "color",
            "field": "region"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 0.5
          }
        }
      }
    },
    {
      "type": "text",
      "name": "legendLabels",
      "from": {
        "data": "regions"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "legendOffset + 22 + (datum.order % 3) * legendColumnWidth"
          },
          "y": {
            "signal": "-50 + floor(datum.order / 3) * 24"
          },
          "cursor": {
            "value": "pointer"
          },
          "opacity": {
            "signal": "activeRegion == null || activeRegion === datum.region ? 1 : 0.3"
          },
          "text": {
            "field": "region"
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#6a5b49"
          },
          "font": {
            "value": "Arial"
          },
          "fontWeight": {
            "value": "normal"
          },
          "limit": {
            "value": 254
          }
        }
      }
    },
    {
      "name": "annotationLeaders",
      "type": "path",
      "interactive": false,
      "from": {
        "data": "annotationTargets"
      },
      "encode": {
        "update": {
          "path": {
            "signal": "'M' + scale('x', (datum.x0 + datum.x1) / 2) + ',' + (scale('y', datum.season) + 3) + ' V' + (scale('y', datum.season) - 6) + ' H' + scale('x', datum.season === 'Winter' ? 0.65 : (datum.x0 + datum.x1) / 2) + ' V' + (scale('y', datum.season) - 10)"
          },
          "stroke": {
            "value": "#52606d"
          },
          "strokeWidth": {
            "value": 1.2
          },
          "fill": {
            "value": null
          },
          "opacity": {
            "signal": "activeRegion == null || activeRegion === datum.region ? 1 : 0.25"
          }
        }
      }
    },
    {
      "name": "annotationArrowheads",
      "type": "symbol",
      "interactive": false,
      "from": {
        "data": "annotationTargets"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "scale('x', (datum.x0 + datum.x1) / 2)"
          },
          "y": {
            "signal": "scale('y', datum.season) + 3"
          },
          "shape": {
            "value": "triangle-down"
          },
          "size": {
            "value": 38
          },
          "fill": {
            "value": "#243447"
          },
          "stroke": {
            "value": "#f7fafc"
          },
          "strokeWidth": {
            "value": 0.7
          },
          "opacity": {
            "signal": "activeRegion == null || activeRegion === datum.region ? 1 : 0.25"
          }
        }
      }
    },
    {
      "name": "insightHeadings",
      "type": "text",
      "interactive": false,
      "from": {
        "data": "seasonInsights"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "width * datum.position"
          },
          "y": {
            "signal": "scale('y', datum.season) + (-52)"
          },
          "baseline": {
            "value": "top"
          },
          "text": {
            "field": "heading"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#243447"
          },
          "align": {
            "value": "center"
          }
        }
      }
    },
    {
      "name": "insightDetails",
      "type": "text",
      "interactive": false,
      "from": {
        "data": "seasonInsights"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "width * datum.position"
          },
          "y": {
            "signal": "scale('y', datum.season) + (-33)"
          },
          "baseline": {
            "value": "top"
          },
          "text": {
            "field": "lines"
          },
          "lineHeight": {
            "value": 14
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#52606d"
          },
          "align": {
            "value": "center"
          }
        }
      }
    },
    {
      "name": "legendTitle",
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "signal": "legendOffset"
          },
          "y": {
            "value": -74
          },
          "text": {
            "value": "State / territory"
          },
          "font": {
            "value": "Arial"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#634320"
          }
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titleFontWeight": "bold",
      "labelColor": "#6a5b49",
      "titleColor": "#634320",
      "symbolType": "square",
      "symbolSize": 100,
      "rowPadding": 8,
      "columnPadding": 24,
      "labelOffset": 8
    }
  },
  "usermeta": {
    "observationWindow": {
      "source": "Dataset/orange_bellied_parrot_cleaned.csv",
      "dateField": "year (eventDate fallback)",
      "years": [
        2017,
        2018,
        2019,
        2020,
        2021,
        2022,
        2023,
        2024,
        2025,
        2026
      ],
      "yearCount": 10,
      "includesPartialLatestYear": true
    }
  }
}
