      "transform": [
        {
          "type": "window",
          "sort": {
            "field": [
              "count",
              "scientific_name"
            ],
            "order": [
              "descending",
              "ascending"
            ]
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "rank"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.rank <= topN ? datum.count : 0",
          "as": "dominantCount"
        }
      ]
    },
    {
      "name": "summary",
      "source": "speciesCounts",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.rank <= 10"
        },
        {
          "type": "aggregate",
          "fields": [
            "count",
            "dominantCount",
            "scientific_name"
          ],
          "ops": [
            "sum",
            "sum",
            "count"
          ],
          "as": [
            "total",
            "dominant",
            "speciesCount"
          ]
        }
      ]
    },
    {
      "name": "topSpecies",
      "source": "speciesCounts",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.rank <= topN"
        },
        {
          "type": "collect",
          "sort": {
            "field": "rank",
            "order": "ascending"
          }
        }
      ]
    },
    {
      "name": "groups",
      "values": [
        {
          "group": "Dominant species",
          "order": 0
        },
        {
          "group": "Other top 10 species",
          "order": 1
        }
      ],
      "transform": [
        {
          "type": "formula",
          "expr": "datum.order === 0 ? totals.dominant : totals.total - totals.dominant",
          "as": "count"
        },
        {
          "type": "formula",
          "expr": "datum.count / totals.total",
          "as": "share"
        },
        {
          "type": "formula",
          "expr": "datum.order === 0 ? topN : totals.speciesCount - topN",
          "as": "speciesCount"
        }
      ]
    },
    {
      "name": "cells",
      "transform": [
        {
          "type": "sequence",
          "start": 0,
          "stop": 100,
          "as": "index"
        },
        {
          "type": "formula",
          "expr": "clamp(cutoff - datum.index, 0, 1)",
          "as": "fraction"
        }
      ]
    },
    {
      "name": "dominantCells",
      "source": "cells",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.fraction > 0"
        }
      ]
    },
    {
      "name": "otherCells",
      "source": "cells",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.fraction < 1"
        }
      ]
    }
  ],
