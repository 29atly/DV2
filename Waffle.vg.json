{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Share of observation records among the top 10 mammal species, comparing dominant species with the remaining species in that top 10. Dominant means the top N species by observation count (default top 1; selectable 1, 3, 5, 10), with scientific name ascending breaking ties. The waffle denominator includes only the top 10 species ranked by observation count. Rankings use 2017–2026 observation dates and all coordinates from Dataset/observations-794195.csv: 6,015 species-level records across 146 species. Subspecies are combined with parent species using the first two scientific-name components; genus-only records are excluded. Embedded aggregates match Lollipop.vg.json. The 10 by 10 grid contains 100 squares, each representing 1% of records; a split boundary square preserves the exact share without rounding to whole squares. Grid reads left to right, top to bottom. Counts reflect recording activity, not abundance. Individual species labels use the shared BumpChart palette. Tile colours encode dominant versus other records rather than individual species. Uses the 10 most recent available observation years (2017–2026), including partial 2026.",
  "width": 840,
  "height": {
    "signal": "max(340, 227 + max(0, length(data('topSpecies')) - 1) * 19)"
  },
  "padding": 16,
  "background": "#f7fafc",
  "title": {
    "text": "How much do dominant species contribute?",
    "subtitle": ["Relative recording activity among selected mammals · 2017–2026"],
    "anchor": "start",
    "font": "Arial",
    "fontSize": 22,
    "color": "#243447",
    "subtitleFontSize": 12,
    "subtitleColor": "#52606d",
    "offset": 16,
    "subtitlePadding": 6,
    "subtitleLineHeight": 16
  },
  "signals": [
    {
      "name": "topN",
      "value": 1,
      "bind": {
        "input": "select",
        "options": [
          1,
          3,
          5,
          10
        ],
        "labels": [
          "Top 1 species",
          "Top 3 species",
          "Top 5 species",
          "Top 10 species"
        ],
        "name": "Dominant species: "
      }
    },
    {
      "name": "hoveredGroup",
      "value": null,
      "on": [
        {
          "events": "@dominantTiles:mouseover, @otherTiles:mouseover",
          "update": "event.item.mark.name === 'dominantTiles' ? 'Dominant species' : 'Other top 10 species'"
        },
        {
          "events": "@legendSymbols:mouseover, @legendLabels:mouseover",
          "update": "datum.group"
        },
        {
          "events": "@dominantTiles:mouseout, @otherTiles:mouseout, @legendSymbols:mouseout, @legendLabels:mouseout",
          "update": "null"
        }
      ]
    },
    {
      "name": "totals",
      "update": "data('summary')[0]"
    },
    {
      "name": "dominantShare",
      "update": "totals.dominant / totals.total"
    },
    {
      "name": "cutoff",
      "update": "dominantShare * 100"
    },
    {
      "name": "legendColumnWidth",
      "value": 280
    },
    {
      "name": "legendSymbolSize",
      "value": 100
    }
  ],
