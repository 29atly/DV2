{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Most recorded mammal species in Dataset/observations-794195.csv. The 2017–2026 window contains 6,015 species-level observations across 146 species; their counts are aggregated and embedded. Subspecies are combined with their parent species using the first two scientific-name components; genus-only records are excluded. Counts include 2017–2026 observation dates and records regardless of coordinates. Top N is selected by count descending with scientific name breaking ties, then displayed in the selected sort order. Counts measure recording activity, not animal abundance. Lollipop heads are plain circles whose centres mark the observation counts. Species colours match the ten-species palette in BumpChart.vg.json; counts and rankings use the selected observation years. Row annotations highlight the Koala share, its lead over Platypus, and the near tie at ranks 4 and 5. A summary updates the share of records covered by the selected Top N. Uses the 10 most recent available observation years (2017–2026), including partial 2026.",
  "width": 760,
  "height": {
    "signal": "length(data(\"topSpecies\")) * 34"
  },
  "padding": 16,
  "background": "#f7fafc",
  "title": {
    "text": "Which species are recorded most often?",
    "subtitle": [
      "6,015 mammal observations · 146 species · 2017–2026"
    ],
    "anchor": "start",
    "font": "Arial",
    "fontSize": 22,
    "color": "#243447",
    "subtitleFont": "Arial",
    "subtitleFontSize": 12,
    "subtitleColor": "#52606d",
    "offset": 80,
    "subtitlePadding": 6,
    "subtitleLineHeight": 16
  },
  "signals": [
    {
      "name": "topN",
      "value": 10,
      "bind": {
        "input": "select",
        "options": [
          5,
          10
        ],
        "labels": [
          "Top 5",
          "Top 10"
        ],
        "name": "Species shown: "
      }
    },
    {
      "name": "sortOrder",
      "value": "Descending",
      "bind": {
        "input": "select",
        "options": [
          "Descending",
          "Ascending"
        ],
        "name": "Sort by observations: "
      }
    },
    {
      "name": "hoveredSpecies",
      "value": null,
      "on": [
        {
          "events": "@stems:mouseover, @dots:mouseover, @counts:mouseover",
          "update": "datum.scientific_name"
        },
        {
          "events": "@stems:mouseout, @dots:mouseout, @counts:mouseout",
          "update": "null"
        }
      ]
    }
  ],
