      "transform": [
        {
          "type": "window",
          "sort": {
            "field": [
              "count",
              "scientific_name"
            ],
            "order": [
              "descending",
              "ascending"
            ]
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "rank"
          ]
        }
      ]
    },
    {
      "name": "topSpecies",
      "source": "speciesCounts",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.rank <= topN"
        },
        {
          "type": "formula",
          "expr": "sortOrder === 'Ascending' ? datum.count : -datum.count",
          "as": "sortKey"
        },
        {
          "type": "collect",
          "sort": {
            "field": [
              "sortKey",
              "scientific_name"
            ],
            "order": [
              "ascending",
              "ascending"
            ]
          }
        }
      ]
    },
    {
      "name": "insightRows",
      "source": "topSpecies",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.rank === 1 || datum.rank === 2 || datum.rank === 4"
        }
      ]
    },
    {
      "name": "shownSummary",
      "source": "topSpecies",
      "transform": [
        {
          "type": "aggregate",
          "fields": [
            "count"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "shownCount"
          ]
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {
        "data": "speciesCounts",
        "field": "count"
      },
      "range": "width",
      "zero": true,
      "nice": true
    },
    {
      "name": "y",
      "type": "band",
      "domain": {
        "data": "topSpecies",
        "field": "scientific_name",
        "sort": {
          "op": "min",
          "field": "sortKey",
          "order": "ascending"
        }
      },
      "range": "height",
      "padding": 0.4
    },
    {
      "name": "speciesColor",
      "type": "ordinal",
      "domain": [
        "Koala",
        "Platypus",
        "Grey-headed Flying-fox",
        "Greater Glider",
        "Spotted-tailed Quoll",
        "European Rabbit",
        "Quokka",
        "Tasmanian Devil",
        "Eastern Barred Bandicoot",
        "Numbat",
        "Australian Sea Lion",
        "Eastern Quoll"
      ],
      "range": [
        "#365B85",
        "#B65C30",
        "#2A8576",
        "#885BA6",
        "#AD4770",
        "#86701D",
        "#397FAD",
        "#6D6B70",
        "#C17A24",
        "#5146A0",
        "#4D7A24",
        "#bab0ab"
      ],
      "unknown": "#7cacc6"
    }
  ],
  "axes": [
    {
      "orient": "bottom",
      "scale": "x",
      "title": "Number of observation records",
      "format": ",d",
      "tickCount": 5,
      "grid": true,
      "gridColor": "#e3e9ef",
      "domain": false,
      "tickColor": "#c9d4df",
      "labelColor": "#52606d",
      "titleColor": "#243447",
      "titlePadding": 14
    },
    {
      "orient": "left",
      "scale": "y",
      "domain": false,
      "ticks": false,
      "labelPadding": 12,
      "labelLimit": 280,
      "labelColor": "#243447",
      "labelFontSize": 12,
      "encode": {
        "labels": {
          "update": {
            "text": {
              "signal": "data('topSpecies')[indexof(domain('y'), datum.value)].species"
            }
          }
        }
      }
    }
  ],
  "marks": [
    {
      "name": "stems",
      "type": "rule",
      "from": {
        "data": "topSpecies"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "x",
            "value": 0
          },
          "strokeWidth": {
            "value": 3
          }
        },
        "update": {
          "x2": {
            "scale": "x",
            "field": "count"
          },
          "y": {
            "scale": "y",
            "field": "scientific_name",
            "band": 0.5
          },
          "stroke": {
            "scale": "speciesColor",
            "field": "species"
          },
          "tooltip": {
            "signal": "{'Species': datum.species, 'Scientific name': datum.scientific_name, 'Observations': format(datum.count, ',d'), 'Share of species-level records': format(datum.count / 6015, '.1%'), 'Overall rank': datum.rank}"
          },
          "strokeWidth": {
            "signal": "hoveredSpecies === datum.scientific_name ? 4 : 3"
          }
        }
      }
    },
    {
      "name": "dots",
      "type": "symbol",
      "from": {
        "data": "topSpecies"
      },
      "encode": {
        "enter": {
          "cursor": {
            "value": "pointer"
          },
          "shape": {
            "value": "circle"
          },
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 1.5
          }
        },
        "update": {
          "x": {
            "scale": "x",
            "field": "count"
          },
          "y": {
            "scale": "y",
            "field": "scientific_name",
            "band": 0.5
          },
          "tooltip": {
            "signal": "{'Species': datum.species, 'Scientific name': datum.scientific_name, 'Observations': format(datum.count, ',d'), 'Share of species-level records': format(datum.count / 6015, '.1%'), 'Overall rank': datum.rank}"
          },
          "description": {
            "signal": "datum.species + ', ' + format(datum.count, ',d') + ' observations'"
          },
          "fill": {
            "scale": "speciesColor",
            "field": "species"
          },
          "size": {
            "signal": "hoveredSpecies === datum.scientific_name ? 220 : 160"
          }
        }
      }
    },
    {
      "name": "counts",
      "type": "text",
      "from": {
        "data": "topSpecies"
      },
      "encode": {
        "enter": {
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "middle"
          },
          "dx": {
            "value": 13
          },
          "font": {
            "value": "Arial"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "#243447"
          }
        },
        "update": {
          "x": {
            "scale": "x",
            "field": "count"
          },
          "y": {
            "scale": "y",
            "field": "scientific_name",
            "band": 0.5
          },
          "text": {
            "signal": "format(datum.count, ',d')"
          }
        }
      }
    },
    {
      "name": "speciesInsights",
      "type": "text",
      "interactive": false,
      "from": {
        "data": "insightRows"
      },
      "encode": {
        "enter": {
          "font": {
            "value": "Arial"
          },
          "fontSize": {
            "value": 11
          },
          "fill": {
            "value": "#52606d"
          }
        },
        "update": {
          "x": {
            "signal": "scale('x', datum.count) + (datum.rank === 1 ? -18 : 65)"
          },
          "y": {
            "scale": "y",
            "field": "scientific_name",
            "band": 0.5
          },
          "dy": {
            "signal": "datum.rank === 1 ? -9 : 0"
          },
          "align": {
            "signal": "datum.rank === 1 ? 'right' : 'left'"
          },
          "baseline": {
            "signal": "datum.rank === 1 ? 'bottom' : 'middle'"
          },
          "text": {
            "signal": "datum.rank === 1 ? 'Koalas dominate: ' + format(datum.count / 6015, '.1%') + ' of all records' : datum.rank === 2 ? 'Koalas have ' + format(data('speciesCounts')[0].count / datum.count, '.1f') + '× as many records as Platypus' : 'Near tie: just 5 records ahead of Spotted-tailed Quoll'"
          }
        }
      }
    },
    {
      "name": "concentrationInsight",
      "type": "text",
      "interactive": false,
      "from": {
        "data": "shownSummary"
      },
      "encode": {
        "enter": {
          "x": {
            "value": 0
          },
          "align": {
            "value": "left"
          },
          "baseline": {
            "value": "top"
          },
          "font": {
            "value": "Arial"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "value": "bold"
          },
          "fill": {
            "value": "#243447"
          }
        },
        "update": {
          "y": {
            "signal": "height + 66"
          },
          "text": {
            "signal": "'The top ' + topN + ' of 146 species account for ' + format(datum.shownCount / 6015, '.1%') + ' of all records.'"
          }
        }
      }
    }
  ],
  "config": {
    "font": "Arial",
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial"
    }
  },
  "usermeta": {
    "observationWindow": {
      "source": "Dataset/observations-794195.csv",
      "dateField": "observed_on",
      "years": [
        2017,
        2018,
        2019,
        2020,
        2021,
        2022,
        2023,
        2024,
        2025,
        2026
      ],
      "yearCount": 10,
      "includesPartialLatestYear": true
    }
  }
}
