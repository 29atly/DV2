            "value": 18
          },
          "y": {
            "field": "y"
          },
          "y2": {
            "field": "y2"
          },
          "fill": {
            "signal": "datum.column === 1 ? '#52606d' : scale('color', datum.name)"
          },
          "opacity": {
            "signal": "!active || indexof(datum.keys, active) >= 0 ? 1 : 0.2"
          },
          "cursor": {
            "value": "pointer"
          },
          "tooltip": {
            "signal": "{'Name': datum.name, 'Stage': datum.level, 'Observations': format(datum.count, ',d'), 'Share of top-five records': format(datum.count / 3597, '.1%'), 'Action': 'Click to highlight connections'}"
          },
          "description": {
            "signal": "datum.name + ': ' + datum.count + ' observations'"
          }
        }
      }
    },
