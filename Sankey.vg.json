      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.column === 1 ? datum.x + 28 : datum.x - 12"
          },
          "y": {
            "signal": "(datum.y + datum.y2) / 2"
          },
          "text": {
            "signal": "datum.label + '  ' + format(datum.count, ',d')"
          },
          "align": {
            "signal": "datum.column === 1 ? 'left' : 'right'"
          },
          "baseline": {
            "value": "middle"
          },
          "fontSize": {
            "value": 12
          },
          "fontWeight": {
            "signal": "datum.column === 0 ? 'normal' : 'bold'"
          },
          "opacity": {
