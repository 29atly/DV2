          },
          "fillOpacity": {
            "signal": "active ? (!active || indexof(datum.keys, active) >= 0 ? 0.75 : 0.055) : 0.34"
          },
          "stroke": {
            "scale": "color",
            "field": "species"
          },
          "strokeWidth": {
            "value": 0.35
          },
          "strokeOpacity": {
            "signal": "!active || indexof(datum.keys, active) >= 0 ? 0.4 : 0.05"
          },
          "tooltip": {
            "signal": "{'From': datum.source, 'To': datum.target, 'Species': datum.species, 'Scientific name': datum.scientific, 'Observations': format(datum.count, ',d'), 'Share of source': format(datum.share, '.1%')}"
          },
          "description": {
            "signal": "datum.source + ' → ' + datum.target + ': ' + datum.count + ' observations'"
          }
        }
      }
    },
