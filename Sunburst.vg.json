            "field": "label"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "scale": "groupColor",
            "field": "group"
          },
          "fontWeight": {
            "signal": "hovered === datum.id ? 'bold' : 'normal'"
          },
          "limit": {
            "value": 245
          },
          "cursor": {
            "signal": "datum.children > 0 ? 'pointer' : 'default'"
          },
          "tooltip": {
            "signal": "{'Name': datum.label, 'Observations': format(datum.total, ',d'), 'Share of current view': format(datum.total / current.total, '.1%')}"
          }
        }
      }
    },
    {
      "name": "childCounts",
      "type": "text",
      "interactive": false,
      "from": {
        "data": "children"
      },
      "encode": {
        "update": {
          "x": {
            "value": 944
          },
          "y": {
            "signal": "244 + (datum.rank - 1) * 26"
          },
          "align": {
            "value": "right"
          },
          "text": {
            "signal": "format(datum.total, ',d')"
