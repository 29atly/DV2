    {
      "name": "tree",
      "source": "taxonomy",
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "partition",
          "field": "count",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "size": [
            1,
            1
          ]
        }
      ]
    },
    {
      "name": "focusNode",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.id === focus"
        }
      ]
    },
    {
      "name": "hoverNode",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.id === hovered"
        }
      ]
    },
    {
      "name": "visible",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.depth > current.depth && datum.x0 >= current.x0 - 1e-10 && datum.x1 <= current.x1 + 1e-10"
        },
        {
          "type": "formula",
          "expr": "2 * PI * (datum.x0 - current.x0) / (current.x1 - current.x0)",
          "as": "start"
        },
        {
          "type": "formula",
          "expr": "2 * PI * (datum.x1 - current.x0) / (current.x1 - current.x0)",
          "as": "end"
        },
        {
          "type": "formula",
          "expr": "hole + (datum.depth - current.depth - 1) * ring",
          "as": "inner"
        },
        {
          "type": "formula",
          "expr": "hole + (datum.depth - current.depth) * ring",
          "as": "outer"
        },
        {
          "type": "formula",
          "expr": "(datum.start + datum.end) / 2",
          "as": "mid"
        }
      ]
    },
    {
      "name": "children",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.parent === focus"
        },
        {
          "type": "window",
          "sort": {
            "field": [
              "total",
              "label"
            ],
            "order": [
              "descending",
              "ascending"
            ]
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "rank"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.rank <= 12"
        }
      ]
    },
    {
      "name": "groupLegend",
      "values": [
        {
          "group": "Marsupials",
          "x": 16
        },
        {
          "group": "Placental mammals",
          "x": 240
        },
        {
          "group": "Monotremes",
          "x": 505
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "groupColor",
      "type": "ordinal",
      "domain": [
        "Marsupials",
        "Placental mammals",
        "Monotremes"
      ],
      "range": [
        "#006F95",
        "#A00097",
        "#8A6900"
      ]
    },
    {
      "name": "orderColor",
      "type": "ordinal",
      "domain": [
        "Marsupials",
        "Placental mammals",
        "Monotremes"
      ],
      "range": [
        "#40A9CE",
        "#CA65C5",
        "#C5A431"
      ]
    },
    {
      "name": "leafColor",
      "type": "ordinal",
      "domain": [
        "Marsupials",
        "Placental mammals",
        "Monotremes"
      ],
      "range": [
        "#B5E4F2",
        "#EEC6EC",
        "#F3E4A1"
      ]
    }
  ],
  "marks": [
    {
      "name": "breadcrumb",
      "type": "text",
      "interactive": false,
      "encode": {
        "update": {
          "x": {
            "value": 16
          },
          "y": {
            "value": 24
          },
          "text": {
            "signal": "current.path"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "#52606d"
          },
          "limit": {
            "value": 920
          }
        }
      }
    },
    {
      "name": "segments",
      "type": "arc",
      "from": {
        "data": "visible"
      },
      "encode": {
        "update": {
          "x": {
            "value": 305
          },
          "y": {
            "value": 335
          },
          "startAngle": {
            "field": "start"
          },
          "endAngle": {
            "field": "end"
          },
          "innerRadius": {
            "field": "inner"
          },
          "outerRadius": {
            "field": "outer"
          },
          "fill": {
            "signal": "scale(datum.depth === 1 ? 'groupColor' : datum.depth === 2 ? 'orderColor' : 'leafColor', datum.group)"
          },
          "fillOpacity": {
            "value": 1
          },
          "stroke": {
            "signal": "hovered === datum.id ? '#243447' : '#ffffff'"
          },
          "strokeWidth": {
            "signal": "hovered === datum.id ? 2.5 : 1"
          },
          "padAngle": {
            "value": 0.003
          },
          "cursor": {
            "signal": "datum.children > 0 ? 'pointer' : 'default'"
          },
          "tooltip": {
            "signal": "{'Name': datum.label, 'Level': datum.level, 'Scientific name': datum.scientific || '—', 'Observations': format(datum.total, ',d'), 'Share of current view': format(datum.total / current.total, '.1%'), 'Species': datum.speciesCount, 'Action': datum.children > 0 ? 'Click to zoom' : 'Species observation records'}"
          },
          "description": {
            "signal": "datum.path + ': ' + format(datum.total, ',d') + ' observations'"
          }
        }
      }
    },
    {
      "name": "arcLabels",
      "type": "text",
      "interactive": false,
      "from": {
        "data": "visible"
      },
      "encode": {
        "update": {
          "x": {
            "value": 305
          },
          "y": {
            "value": 335
          },
          "theta": {
            "field": "mid"
          },
          "radius": {
            "signal": "(datum.inner + datum.outer) / 2"
          },
          "angle": {
            "signal": "datum.mid * 180 / PI + (datum.mid > PI / 2 && datum.mid < 3 * PI / 2 ? 180 : 0)"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "middle"
          },
          "text": {
            "field": "label"
          },
          "fontSize": {
            "value": 11
          },
          "fontWeight": {
            "signal": "datum.children > 0 ? 'bold' : 'normal'"
          },
          "fill": {
            "signal": "datum.depth === 1 ? '#ffffff' : '#243447'"
          },
          "limit": {
            "signal": "min(130, (datum.end - datum.start) * (datum.inner + datum.outer) / 2 - 12)"
          },
          "opacity": {
            "signal": "(datum.end - datum.start) * (datum.inner + datum.outer) / 2 > 65 ? 1 : 0"
          }
        }
      }
    },
    {
      "name": "centre",
      "type": "arc",
      "encode": {
        "update": {
          "x": {
            "value": 305
          },
          "y": {
            "value": 335
          },
          "startAngle": {
            "value": 0
          },
          "endAngle": {
            "signal": "2 * PI"
          },
          "innerRadius": {
            "value": 0
          },
          "outerRadius": {
            "signal": "hole - 2"
          },
          "fill": {
            "value": "#243447"
          },
          "stroke": {
            "value": "#dce4ed"
          },
          "cursor": {
            "signal": "focus === 'all' ? 'default' : 'pointer'"
          },
          "tooltip": {
            "signal": "focus === 'all' ? 'All selected mammal observations' : 'Return to ' + current.parent"
          }
        }
      }
    },
    {
